# Preserve exact bytes for SHA256 evidence across Windows and POSIX.
# This disables automatic EOL conversion but does not disable text diff.
* -text
*.[sS][tT][eE][pP] filter=lfs diff=lfs merge=lfs -text
*.[sS][tT][pP] filter=lfs diff=lfs merge=lfs -text
*.[iI][gG][eE][sS] filter=lfs diff=lfs merge=lfs -text
*.[iI][gG][sS] filter=lfs diff=lfs merge=lfs -text
*.[fF][cC][sS][tT][dD] filter=lfs diff=lfs merge=lfs -text
*.[sS][tT][lL] filter=lfs diff=lfs merge=lfs -text
*.[vV][tT][kK] filter=lfs diff=lfs merge=lfs -text
*.[vV][tT][uU] filter=lfs diff=lfs merge=lfs -text
*.[fF][rR][dD] filter=lfs diff=lfs merge=lfs -text
*.[iI][nN][pP] filter=lfs diff=lfs merge=lfs -text
*.[mM][sS][hH] filter=lfs diff=lfs merge=lfs -text
*.[cC][gG][nN][sS] filter=lfs diff=lfs merge=lfs -text
*.[pP][dD][fF] filter=lfs diff=lfs merge=lfs -text
